# Workers Static Assets reads this file. Files in /_astro/ have a content hash
# in their name, so a browser can reuse them without asking the server again.
# The default, max-age=0 with must-revalidate, costs a round trip per file on
# every page load, and the heading font painted in the fallback font meanwhile.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
