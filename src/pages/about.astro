---
import { getEntry, render } from "astro:content";
import Site from "../layouts/Site.astro";
import { Pill, PillCollection } from "../components/Pill";

async function renderAboutSection(id: string) {
  const entry = await getEntry("about", id);
  if (!entry) throw new Error(`Missing about section: content/about/${id}.mdx`);
  return (await render(entry)).Content;
}

const Intro = await renderAboutSection("intro");
const Professional = await renderAboutSection("professional");
const Personal = await renderAboutSection("personal");

const components = {
  Pill, PillCollection,
  Link: "a",
};
---

<Site>
  <div>
    <div><Intro components={components} /></div>
    <div class="bg-background-secondary mt-4 rounded-[20px] pb-8">
      {/* Selector */}
      <div class="selector">
        <input type="radio" name="bio" id="bio-toggle-professional" checked />
        <label class="font-bold" for="bio-toggle-professional">Profesional</label>
        <input type="radio" name="bio" id="bio-toggle-personal" />
        <label class="font-bold" for="bio-toggle-personal">Personal</label>
        <div class="indicator"></div>
      </div>
      {/* Content sections */}
      <div class="px-4">
        <div id="bio-professional"><Professional components={components} /></div>
        <div id="bio-personal" class="hidden"><Personal components={components} /></div>
      </div>
    </div>
  </div>
</Site>

<script>
  function initBioSelector() {
    const proRadio = document.getElementById("bio-toggle-professional") as HTMLInputElement;
    const perRadio = document.getElementById("bio-toggle-personal") as HTMLInputElement;
    const proContent = document.getElementById("bio-professional");
    const perContent = document.getElementById("bio-personal");

    if (!proRadio || !perRadio || !proContent || !perContent) return;

    function update() {
      if (proRadio.checked) {
        proContent!.classList.remove("hidden");
        perContent!.classList.add("hidden");
      } else {
        proContent!.classList.add("hidden");
        perContent!.classList.remove("hidden");
      }
    }

    proRadio.addEventListener("change", update);
    perRadio.addEventListener("change", update);
    update();
  }

  initBioSelector();
  document.addEventListener("astro:after-swap", initBioSelector);
</script>
