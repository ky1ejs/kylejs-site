---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Site from "../layouts/Site.astro";
import RelativeDateLabel from "../components/RelativeDateLabel.astro";
import { AreaBand, AreaCard, AreaRail, Button, MediaPlaceholder, SocialLinks } from "../design/components";
import meImage from "../assets/me.jpg";
import { postsByArea } from "../lib/area-posts";

const areas = (await getCollection("areas")).sort((a, b) => a.data.order - b.data.order);
const bands = areas.filter((a) => a.data.display === "band");
const compact = areas.filter((a) => a.data.display === "compact");

const posts = await getCollection("blog");
const latest = posts.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

// Posts list their areas in frontmatter. Fails the build on an unknown area.
const areaPosts = postsByArea(
  areas.map((a) => a.id),
  posts,
);
const postsFor = (area: (typeof areas)[number]) => areaPosts.get(area.id) ?? [];

/** The area's posts, newest first, then its other items. */
const itemsFor = (area: (typeof areas)[number]) => [
  ...postsFor(area).map((post) => ({
    kind: "Post",
    title: post.data.title,
    desc: post.data.description,
    href: `/posts/${post.id}`,
    writing: true,
  })),
  ...area.data.items,
];

const postCount = (area: (typeof areas)[number]) => {
  const n = postsFor(area).length;
  return n === 0 ? undefined : n === 1 ? "1 post" : `${n} posts`;
};
---

<Site
  width="wide"
  description="Kyle Satti — engineer in NYC. Writing, side projects, 3D printing, electronics, keyboards, coffee and the rest of it."
>
  <header class="pt-12 pb-10 min-[640px]:pt-16">
    <div class="mb-6 flex items-center gap-3">
      <Image
        src={meImage}
        alt="Headshot of Kyle Satti"
        width={56}
        height={56}
        densities={[2, 3]}
        loading="eager"
        class="h-14 w-14 shrink-0 rounded-full object-cover"
      />
      <div>
        <p class="text-ink m-0 font-semibold">Kyle Satti</p>
        <p class="ks-label m-0 pt-0.5">Staff Engineer · Spotify · NYC</p>
      </div>
    </div>

    <h1 class="mt-0 mb-4 max-w-[20ch] text-[2.25rem] leading-[1.05] tracking-[-0.035em] text-balance min-[640px]:text-[3.5rem]">
      I like to build teams and create things, mostly with an <s class="decoration-[0.08em]">IDE</s> agents, a camera or a 3D printer.
    </h1>
    <p class="text-ink-2 m-0 max-w-[58ch] text-[17px] leading-relaxed">
      I also like to create with electronics, various coffee toys and to leave all that behind to hike and fish.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
      <Button href={`/posts/${latest.id}`}>Latest: {latest.data.title}</Button>
      <Button href="/posts" variant="more">All writing</Button>
    </div>
    <p class="ks-meta mt-3"><RelativeDateLabel date={latest.data.date} /></p>

    <div class="mt-5">
      <SocialLinks size={22} />
    </div>
  </header>

  <AreaRail
    areas={areas.map((a) => ({ id: a.id, label: a.data.railLabel ?? a.data.title, mark: a.data.mark }))}
  />

  <div class="mt-8 flex flex-col gap-6">
    {
      bands.map((area) => {
        const { images, layout } = area.data.media;
        const props = {
          id: area.id,
          title: area.data.title,
          mark: area.data.mark,
          meta: area.data.meta,
          why: area.data.why,
          chain: area.data.chain,
          items: itemsFor(area),
          mediaLayout: layout,
        };
        // Astro passes an empty slot as a prop, so only open one for images
        return images.length > 0 ? (
          <AreaBand {...props}>
            <div slot="media" class="ks-media-grid" data-count={images.length}>
              {images.map((img) =>
                img.src ? (
                  <Image src={img.src} alt={img.alt} widths={[480, 960]} sizes="(min-width: 720px) 480px, 100vw" />
                ) : (
                  <MediaPlaceholder label={img.label ?? img.alt} />
                ),
              )}
            </div>
          </AreaBand>
        ) : (
          <AreaBand {...props} />
        );
      })
    }
  </div>

  <div class="mt-6 grid gap-4 min-[640px]:grid-cols-2">
    {
      compact.map((area) => (
        <div id={area.id} class="scroll-mt-[var(--ks-rail-height)]">
          <AreaCard
            title={area.data.title}
            why={area.data.why}
            mark={area.data.mark}
            count={postCount(area)}
            href={itemsFor(area)[0]?.href}
          />
        </div>
      ))
    }
  </div>
</Site>
