---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import RelativeDateLabel from "../../components/RelativeDateLabel.astro";
import calculateReadingTime from "../../lib/reading-time";
import { PostListItem } from "../../design/components";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Site title="Writing · kylejs" description="Posts by Kyle Satti on engineering, management and the things he makes." section="writing">
  <div class="mt-10">
    <p class="ks-label m-0">Writing</p>
    <h1 class="mt-2 mb-3">Projects, learnings and thinking, out in the open.</h1>
    <p class="text-ink-2 m-0 max-w-[60ch] text-[17px] leading-relaxed">
      I write to connect with people working on similar things. More on why in{" "}
      <a href="/posts/why-blog">this post</a>. If something here resonates, my socials are in the footer.
    </p>
  </div>
  <ul class="ks-post-list mt-8">
    {
      posts.map((p) => (
        <li>
          <PostListItem href={`/posts/${p.id}`} title={p.data.title} description={p.data.description}>
            <Fragment slot="meta">
              <RelativeDateLabel date={p.data.date} />
              {" "}<span aria-hidden="true">·</span>{" "}
              {calculateReadingTime(p.body || "")}
            </Fragment>
          </PostListItem>
        </li>
      ))
    }
  </ul>
</Site>
