---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import RelativeDateLabel from "../../components/RelativeDateLabel.astro";
import calculateReadingTime from "../../lib/reading-time";
import { getMostReadPostIds } from "../../lib/most-read";
import { PostListItem } from "../../design/components";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
// Empty when the analytics variables are unset, as in local and CI builds
const mostRead = (await getMostReadPostIds(posts.map((p) => p.id)))
  .map((id) => posts.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---

<Site title="Writing · kylejs" description="Posts by Kyle Satti on engineering, management and the things he makes." section="writing">
  <div class="mt-10">
    <p class="ks-label m-0">Writing</p>
    <h1 class="mt-2 mb-3">Projects, learnings and thinking, out in the open.</h1>
    <p class="text-ink-2 m-0 max-w-[60ch] text-[17px] leading-relaxed">
      I write to connect with people working on similar things. More on why in{" "}
      <a href="/posts/why-blog">this post</a>. If something here resonates, my socials are in the footer.
    </p>
  </div>
  {
    mostRead.length > 0 && (
      <section class="mt-10" aria-labelledby="most-read">
        <h2 id="most-read" class="ks-label m-0">Most read</h2>
        <ul class="ks-post-list mt-2">
          {mostRead.map((p) => (
            <li>
              <PostListItem href={`/posts/${p.id}`} title={p.data.title} headingLevel={3}>
                <Fragment slot="meta">{calculateReadingTime(p.body || "")}</Fragment>
              </PostListItem>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class={mostRead.length > 0 ? "mt-10" : "mt-8"} aria-labelledby={mostRead.length > 0 ? "all-posts" : undefined}>
    {mostRead.length > 0 && <h2 id="all-posts" class="ks-label m-0">All posts</h2>}
    <ul class:list={["ks-post-list", { "mt-2": mostRead.length > 0 }]}>
      {
        posts.map((p) => (
          <li>
            <PostListItem
              href={`/posts/${p.id}`}
              title={p.data.title}
              description={p.data.description}
              headingLevel={mostRead.length > 0 ? 3 : 2}
            >
              <Fragment slot="meta">
                <RelativeDateLabel date={p.data.date} />
                {" "}<span aria-hidden="true">·</span>{" "}
                {calculateReadingTime(p.body || "")}
              </Fragment>
            </PostListItem>
          </li>
        ))
      }
    </ul>
  </section>
</Site>
