---
// Cloudflare Web Analytics: cookieless page views, read back by
// scripts/weekly-report.mjs. The token is public; it ships in every page.
// Create it in the Cloudflare dashboard (Web Analytics > Add a site >
// kylejs.me, then "Manual setup" to see it). Empty renders nothing.
const TOKEN = "";

const hostname = Astro.site?.hostname ?? "kylejs.me";
---

{/*
  Loaded only on the production hostname, so workers.dev previews and local
  builds (including `pnpm check:layout-shift`) send nothing. The beacon
  follows ClientRouter navigations itself through the History API. This
  script is the same on every page, so a ClientRouter swap keeps it in
  <head> rather than running it again.
*/}
{
  TOKEN && (
    <script is:inline define:vars={{ token: TOKEN, hostname }}>
      if (location.hostname === hostname) {
        const beacon = document.createElement("script");
        beacon.type = "module";
        beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
        beacon.dataset.cfBeacon = JSON.stringify({ token });
        document.head.append(beacon);
        // ClientRouter drops <head> elements the next page lacks. A copy in
        // the incoming page keeps this tag, so the beacon can still find
        // its token, and the copy is discarded rather than run again.
        document.addEventListener("astro:before-swap", (e) => {
          e.newDocument.head.append(beacon.cloneNode());
        });
      }
    </script>
  )
}
