---
import PostMetadata from "./PostMetadata.astro";

interface Props {
  title: string;
  content: string;
  date: Date;
}

const { title, content, date } = Astro.props;
---

<div class="flex flex-col gap-2">
  <h1 class="post-title">{title}</h1>
  <PostMetadata title={title} content={content} date={date} />
</div>
