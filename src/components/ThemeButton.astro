---
interface Props {
  // Where the popover opens relative to the button. "responsive" opens above
  // on narrow screens, where the home page puts the button at the bottom
  position?: "top" | "bottom" | "responsive";
}

const { position = "bottom" } = Astro.props;

const POPOVER_POSITION = {
  top: "bottom-12",
  bottom: "top-12",
  responsive: "bottom-12 min-[500px]:top-12 min-[500px]:bottom-auto",
};

// Line icons on a 24 grid, matching the marks' 1.75px stroke
const ICONS = {
  light:
    "M12 16a4 4 0 1 0 0-8a4 4 0 0 0 0 8z M12 2v2 M12 20v2 M4.9 4.9l1.4 1.4 M17.7 17.7l1.4 1.4 M2 12h2 M20 12h2 M4.9 19.1l1.4-1.4 M17.7 6.3l1.4-1.4",
  dark: "M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z",
  system: "M3.5 5h17a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M8 21h8 M12 17v4",
};

const OPTIONS = [
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
  { value: "system", label: "System" },
] as const;
---

<div class="theme-control relative">
  <button id="theme-button" class="ks-icon-button" aria-label="Change theme" aria-expanded="false" aria-controls="theme-popover">
    {
      OPTIONS.map((o) => (
        <svg
          class="theme-icon h-5 w-5"
          data-icon={o.value}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={ICONS[o.value]} />
        </svg>
      ))
    }
  </button>
  <div
    id="theme-popover"
    class={`absolute right-0 ${POPOVER_POSITION[position]} bg-surface border-rule hidden w-40 overflow-hidden rounded-xl border py-1 text-sm shadow-md dark:shadow-none`}
  >
    {
      OPTIONS.map((o) => (
        <button
          class="theme-option text-ink hover:bg-paper flex min-h-11 w-full items-center gap-2 px-3 text-left"
          data-theme-value={o.value}
        >
          <svg
            class="text-ink-2 h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={ICONS[o.value]} />
          </svg>
          <span class="theme-option-label">{o.label}</span>
        </button>
      ))
    }
  </div>
</div>

<style is:global>
  /* One icon per stored choice; html[data-theme-pref] is set before paint */
  .theme-icon {
    display: none;
  }
  :root:not([data-theme-pref]) .theme-icon[data-icon="system"],
  :root[data-theme-pref="system"] .theme-icon[data-icon="system"],
  :root[data-theme-pref="light"] .theme-icon[data-icon="light"],
  :root[data-theme-pref="dark"] .theme-icon[data-icon="dark"] {
    display: block;
  }
</style>

<script>
  // Document and media-query listeners outlive a ClientRouter swap, so the
  // previous page's are removed before adding new ones
  let listeners: AbortController | undefined;

  function initThemeButton() {
    listeners?.abort();
    listeners = new AbortController();
    const { signal } = listeners;
    const button = document.getElementById("theme-button");
    const popover = document.getElementById("theme-popover");
    if (!button || !popover) return;

    const MEDIA_QUERY = "(prefers-color-scheme: dark)";

    function getStoredTheme(): string {
      return (
        document.cookie
          .split("; ")
          .find((row) => row.startsWith("theme="))
          ?.split("=")[1] || "system"
      );
    }

    function getEffectiveTheme(theme: string): string {
      if (theme === "light" || theme === "dark") return theme;
      return window.matchMedia(MEDIA_QUERY).matches ? "dark" : "light";
    }

    function applyTheme(theme: string) {
      document.cookie = `theme=${theme};path=/;max-age=31536000`;
      document.documentElement.setAttribute("data-theme", getEffectiveTheme(theme));
      updateIcon(theme);
    }

    // The icon follows data-theme-pref on <html>, set before paint in Base.astro
    function updateIcon(theme: string) {
      document.documentElement.setAttribute("data-theme-pref", theme);
      popover!.querySelectorAll<HTMLElement>(".theme-option").forEach((opt) => {
        opt.setAttribute("aria-pressed", String(opt.dataset.themeValue === theme));
      });
      const systemLabel = popover!.querySelector('[data-theme-value="system"] .theme-option-label');
      if (systemLabel) systemLabel.textContent = `System (${getEffectiveTheme("system")})`;
    }

    function setOpen(open: boolean) {
      popover!.classList.toggle("hidden", !open);
      button!.setAttribute("aria-expanded", String(open));
    }

    updateIcon(getStoredTheme());

    button.addEventListener("click", () => {
      setOpen(popover.classList.contains("hidden"));
    });

    popover.querySelectorAll<HTMLElement>(".theme-option").forEach((opt) => {
      opt.addEventListener("click", () => {
        applyTheme(opt.dataset.themeValue!);
        setOpen(false);
        button.focus();
      });
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!button.contains(target) && !popover.contains(target)) setOpen(false);
    }, { signal });

    // Close when keyboard focus moves past the last option
    button.parentElement!.addEventListener("focusout", (e) => {
      const next = e.relatedTarget as Node | null;
      if (!next || (!button.contains(next) && !popover.contains(next))) setOpen(false);
    }, { signal });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popover.classList.contains("hidden")) {
        setOpen(false);
        button.focus();
      }
    }, { signal });

    window.matchMedia(MEDIA_QUERY).addEventListener("change", () => {
      if (getStoredTheme() === "system") {
        document.documentElement.setAttribute("data-theme", getEffectiveTheme("system"));
        updateIcon("system");
      }
    }, { signal });
  }

  initThemeButton();
  document.addEventListener("astro:after-swap", initThemeButton);
</script>
