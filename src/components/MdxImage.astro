---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import sharp from "sharp";

interface Props {
  src: string;
  alt?: string;
  className?: string;
  // Rendered width hint for srcset selection; defaults to the full post column
  sizes?: string;
  // Above-the-fold images: load eagerly at high priority, no blur-in
  priority?: boolean;
}

// Post column: max-w-[800px] minus content-inset padding (2rem each side)
const COLUMN_SIZES = "(min-width: 800px) 736px, calc(100vw - 4rem)";
// Column width at 2x DPR; larger files are never picked
const MAX_WIDTH = 1472;

const { src, alt = "", className, sizes = COLUMN_SIZES, priority = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/posts/images/*.{jpeg,jpg,png,webp}",
);

const filename = src.split("/").pop();
const matchingKey = Object.keys(images).find((key) => key.endsWith(`/${filename}`));
if (!matchingKey) {
  // Fail the build rather than ship an image that skips optimization
  throw new Error(`<Image src="${src}">: ${filename} not found in src/assets/posts/images/`);
}
const image = (await images[matchingKey]()).default;

let placeholder: string | undefined;
if (!priority) {
  const buffer = await sharp(`${process.cwd()}${matchingKey}`).resize(20).blur().webp({ quality: 20 }).toBuffer();
  placeholder = `data:image/webp;base64,${buffer.toString("base64")}`;
}
---

<Picture
  src={image}
  alt={alt}
  formats={["avif"]}
  fallbackFormat="webp"
  layout="constrained"
  width={Math.min(image.width, MAX_WIDTH)}
  sizes={sizes}
  class:list={[className, placeholder && "img-loading"]}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  style={placeholder && `background-image:url(${placeholder});background-size:cover`}
  onload={placeholder && "this.classList.add('img-loaded')"}
/>
