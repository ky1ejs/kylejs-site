---
import RelativeDateLabel from "./RelativeDateLabel.astro";
import calculateReadingTime from "../lib/reading-time";
import { getImage } from "astro:assets";
import meImage from "../assets/me.jpg";
import { Byline } from "../design/components";

interface Props {
  content: string;
  date: Date;
}

const { content, date } = Astro.props;

// 40px avatar, 2x and 3x for high-density screens
const avatar = await getImage({ src: meImage, width: 80, height: 80, format: "webp" });
const avatar3x = await getImage({ src: meImage, width: 120, height: 120, format: "webp" });
---

<Byline
  name="Kyle Satti"
  href="/"
  avatar={{
    src: avatar.src,
    srcSet: `${avatar.src} 2x, ${avatar3x.src} 3x`,
    width: 40,
    height: 40,
  }}
>
  <Fragment slot="meta">
    <span class="whitespace-nowrap">{calculateReadingTime(content)}</span>
    {" "}<span aria-hidden="true">·</span>{" "}
    <span class="whitespace-nowrap"><RelativeDateLabel date={date} /></span>
  </Fragment>
</Byline>
