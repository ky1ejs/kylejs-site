---
import RelativeDateLabel from "./RelativeDateLabel.astro";
import calculateReadingTime from "../lib/reading-time";
import { Image } from "astro:assets";
import meImage from "../assets/me.jpg";

interface Props {
  content: string;
  date: Date;
  showAvatar?: boolean;
}

const { content, date, showAvatar = true } = Astro.props;
---

<div class="text-muted mb-4 flex items-center gap-3 text-sm">
  {showAvatar && (
    <a href="/" class="shrink-0" aria-hidden="true" tabindex="-1">
      <Image
        src={meImage}
        width={80}
        height={80}
        alt=""
        loading="eager"
        class="h-10 w-10 rounded-full transition hover:scale-110"
      />
    </a>
  )}
  <div class="flex flex-col gap-0.5">
    {showAvatar && (
      <div>
        by{" "}
        <a href="/" class="hover:text-primary transition">
          Kyle Satti
        </a>
      </div>
    )}
    <div>
      <span class="whitespace-nowrap">{calculateReadingTime(content)}</span>
      {" "}<span aria-hidden="true">·</span>{" "}
      <span class="whitespace-nowrap">
        <RelativeDateLabel date={date} />
      </span>
    </div>
  </div>
</div>
