---
interface Props {
  date: Date;
}

const { date } = Astro.props;

function ordinalStringForNumber(n: number): string {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
}

// Frontmatter dates are calendar dates, parsed as UTC midnight
const day = date.getUTCDate();
const month = date.toLocaleString("en-US", { month: "long", timeZone: "UTC" });
const year = date.getUTCFullYear();
const absolute = `${ordinalStringForNumber(day)} of ${month}, ${year}`;
const isoDate = date.toISOString().slice(0, 10);
const fullDate = date.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<span class="cursor-pointer" title={fullDate} data-relative-date={isoDate}>
  {absolute}
</span>

{/*
  A classic inline script runs before the label is painted. A module script
  runs after parsing, so the absolute date showed first and the line shifted.
  `applyRelativeDate` is defined in Base.astro, which also applies it to the
  incoming page on ClientRouter navigations.
*/}
<script is:inline>
  applyRelativeDate(document.currentScript.previousElementSibling);
</script>
