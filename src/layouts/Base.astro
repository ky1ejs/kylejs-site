---
import { ClientRouter } from "astro:transitions";
import PageLoader from "../components/PageLoader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  publishedTime?: string;
}

const {
  title = "kylejs",
  description = "Kyle Satti | Product Engineer based in Brooklyn, NY.",
  ogImage,
  ogType = "website",
  ogUrl,
  publishedTime,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://kylejs.me";
// `build.format: "file"` puts `.html` in the build-time pathname; public URLs have none
const pathname = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const canonicalUrl = ogUrl || `${siteUrl}${pathname}`;
const imageUrl = ogImage ? `${siteUrl}${ogImage}` : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Kyle Satti" />
    <meta property="og:locale" content="en_US" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:modified_time" content={publishedTime} />}
    {publishedTime && <meta property="article:author" content="Kyle Satti" />}

    {/* Twitter */}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@_kylejs_" />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    {/*
      Disable native View Transitions API to prevent iOS Safari from clipping
      the bottom of the screen during navigation animations. The ClientRouter
      falls back to a direct DOM swap instead of snapshot-based transitions.
    */}
    <script is:inline>
      document.startViewTransition = undefined;
    </script>
    <ClientRouter />

    {/* Theme detection - runs before paint to prevent flash */}
    <script is:inline>
      function applyTheme() {
        try {
          const cookieTheme = document.cookie
            .split("; ")
            .find((row) => row.startsWith("theme="));
          const theme = cookieTheme ? cookieTheme.split("=")[1] : null;

          if (theme && theme !== "system") {
            document.documentElement.setAttribute("data-theme", theme);
          } else {
            const effective = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.setAttribute("data-theme", effective);
          }
        } catch (e) {
          console.error(e);
        }
      }
      applyTheme();

      document.addEventListener("astro:before-swap", (e) => {
        const currentTheme = document.documentElement.getAttribute("data-theme");
        if (currentTheme) {
          e.newDocument.documentElement.setAttribute("data-theme", currentTheme);
        }
      });
    </script>

    {/*
      Relative post dates ("Posted yesterday"). "Today" depends on the reader's
      time zone and the day they read the post, so the build can't set them.
      They are applied before paint: by an inline call after each label on a
      full load, and to the incoming document here on ClientRouter navigations.
    */}
    <script is:inline>
      function applyRelativeDate(el) {
        const [year, month, day] = (el.dataset.relativeDate ?? "").split("-").map(Number);
        const posted = new Date(year, month - 1, day);
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        // Round, as a day across a DST change is 23 or 25 hours
        const daysAgo = Math.round((today.getTime() - posted.getTime()) / 86400000);

        if (daysAgo === 0) el.textContent = "Posted today";
        else if (daysAgo === 1) el.textContent = "Posted yesterday";
        else if (daysAgo > 1 && daysAgo <= 7) el.textContent = `Posted ${daysAgo} days ago`;
      }

      document.addEventListener("astro:before-swap", (e) => {
        e.newDocument.querySelectorAll("[data-relative-date]").forEach(applyRelativeDate);
      });
    </script>
  </head>
  <body>
    <slot />
    <PageLoader />
  </body>
</html>
