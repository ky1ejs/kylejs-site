---
import Base from "./Base.astro";
import ThemeButton from "../components/ThemeButton.astro";
import HeadingLinks from "../components/HeadingLinks.astro";
import { SiteHeader, SiteFooter, type NavSection } from "../design/components";
import { TEXT_COLUMN_CLASS, WIDE_COLUMN_CLASS } from "../lib/layout";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  publishedTime?: string;
  /** Nav item marked as the current page */
  section?: NavSection;
  /** text: 680px column for reading. wide: 1120px, for the home page and grids */
  width?: "text" | "wide";
}

const { section, width = "text", ...props } = Astro.props;

const sections: NavSection[] = ["writing", "projects", "about"];
const year = new Date().getFullYear();
---

<Base {...props}>
  <SiteHeader current={section} sections={sections}>
    <ThemeButton />
  </SiteHeader>
  <div class={width === "wide" ? WIDE_COLUMN_CLASS : TEXT_COLUMN_CLASS}>
    <main data-page-content>
      <slot />
    </main>
    <div class="pt-12">
      <SiteFooter year={year} sections={sections} />
    </div>
  </div>
  <HeadingLinks />
</Base>
